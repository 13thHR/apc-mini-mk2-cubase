var midiremote_api = require('midiremote_api_v1');

// DRIVER SETUP
var deviceDriver = midiremote_api.makeDeviceDriver('Akai', 'APC Mini Mk2', 'William');
var midiInput = deviceDriver.mPorts.makeMidiInput();
var midiOutput = deviceDriver.mPorts.makeMidiOutput();

deviceDriver.makeDetectionUnit().detectPortPair(midiInput, midiOutput)
    .expectInputNameEquals('APC MINI MK2')
    .expectOutputNameEquals('APC MINI MK2');

var surface = deviceDriver.mSurface;

// CC numbers
var faderCC = [48, 49, 50, 51, 52, 53, 54, 55, 57];
var transportCC = { Play: 112, Stop: 113, Record: 114 };

var faders = [];
var transportButtons = {};
var pads = [];

// SURFACE ELEMENTS (FADERS)
for (var i = 0; i < faderCC.length; i++) {
    var fader = surface.makeFader(i * 3, 25, 2, 20); // Correct: makeFader()
    fader.mSurfaceValue.mMidiBinding
        .setInputPort(midiInput)
        .setOutputPort(midiOutput)
        .bindToControlChange(0, faderCC[i]);
    faders.push(fader);
}

// TRANSPORT BUTTONS
function makeTransportButton(name, x) {
    var cc = transportCC[name];
    var btn = surface.makeButton(x, 50, 2.5, 2.5);
    btn.mSurfaceValue.mMidiBinding
        .setInputPort(midiInput)
        .setOutputPort(midiOutput)
        .bindToControlChange(0, cc);
    transportButtons[name] = btn;
    return btn;
}

makeTransportButton('Play', 0);
makeTransportButton('Stop', 3);
makeTransportButton('Record', 6);

// PADS (8x8 Grid)
function makePad(row, col) {
    var pad = surface.makeTriggerPad(col * 2.5, row * 2.5, 2.5, 2.5);
    pad.mSurfaceValue.mMidiBinding
        .setInputPort(midiInput)
        .setOutputPort(midiOutput)
        .bindToNote(0, row * 8 + col + 36);
    pads.push(pad);
    return pad;
}

for (var r = 0; r < 8; r++) {
    for (var c = 0; c < 8; c++) {
        makePad(r, c);
    }
}

// HOST MAPPING
var page = deviceDriver.mMapping.makePage('Mixer');

// Mixer zone
var mixerZone = page.mHostAccess.mMixConsole.makeMixerBankZone()
    .excludeInputChannels()
    .excludeOutputChannels();

var mixerChannels = [];
for (var i = 0; i < 8; i++) {
    var channel = mixerZone.makeMixerBankChannel();
    mixerChannels.push(channel);
    page.makeValueBinding(faders[i].mSurfaceValue, channel.mValue.mVolume);
}

// Master fader safe binding
if (page.mHostAccess.mControlRoom && page.mHostAccess.mControlRoom.mMainVolume) {
    page.makeValueBinding(faders[8].mSurfaceValue, page.mHostAccess.mControlRoom.mMainVolume);
} else {
    var masterChannel = mixerZone.makeMixerBankChannel();
    page.makeValueBinding(faders[8].mSurfaceValue, masterChannel.mValue.mVolume);
}

// Transport safe binding
if (page.mHostAccess.mTransport && page.mHostAccess.mTransport.mAction) {
    page.makeActionBinding(transportButtons['Play'].mSurfaceValue, page.mHostAccess.mTransport.mAction.mPlay);
    page.makeActionBinding(transportButtons['Stop'].mSurfaceValue, page.mHostAccess.mTransport.mAction.mStop);
    page.makeActionBinding(transportButtons['Record'].mSurfaceValue, page.mHostAccess.mTransport.mAction.mRecord);
}

// LED FEEDBACK safe binding
function setLED(note, color) {
    midiOutput.sendMidi(0x90, note, color);
}

if (page.mHostAccess.mTransport && page.mHostAccess.mTransport.mValue) {
    if (page.mHostAccess.mTransport.mValue.mIsPlaying) {
        page.mHostAccess.mTransport.mValue.mIsPlaying.addOnChange(function(context, value) {
            setLED(112, value ? 1 : 0);
        });
    }
    if (page.mHostAccess.mTransport.mValue.mIsRecording) {
        page.mHostAccess.mTransport.mValue.mIsRecording.addOnChange(function(context, value) {
            setLED(114, value ? 2 : 0);
        });
    }
}